NODE_ENV=development
PORT=3000

# Postgres (Railway: link to the Postgres plugin's DATABASE_URL variable)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workforce_connect?schema=public"

# Redis (Railway: link to the Redis plugin's REDIS_URL variable)
# Not actively used by any feature yet in this MVP Sprint — reserved for
# future caching/queue use. Safe to leave as-is or omit in dev.
REDIS_URL="redis://localhost:6379"

# JWT — generate strong random values for production, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS — comma-separated list of allowed frontend origins. NEVER leave
# unset in production: an unset value falls back to localhost-only
# origins (see src/main.ts), which will correctly BLOCK your deployed
# frontend until you set this explicitly.
#
# Local dev:
#   CORS_ORIGIN="http://localhost:3001"
# Railway (include BOTH local dev and your deployed frontend so you can
# still test against the deployed API from your machine while developing):
#   CORS_ORIGIN="http://localhost:3001,https://<your-frontend>.up.railway.app"
CORS_ORIGIN="http://localhost:3001"
