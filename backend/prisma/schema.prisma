// ==========================================================================
// WorkForce Connect AI — Database Schema (Phase 1)
// Multi-Tenant SaaS for multilingual workforce communication
// ==========================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" covers local development (whatever OS/libc you're on).
  // "linux-musl-openssl-3.0.x" explicitly targets the node:20-alpine
  // runtime used in backend/Dockerfile (Alpine 3.18+ ships OpenSSL 3.x).
  // Without this, Prisma's auto-detection can fail inside certain build
  // environments (observed: "Prisma failed to detect the libssl/openssl
  // version... Defaulting to openssl-1.1.x") and silently fetch a query
  // engine binary that doesn't match the actual container at runtime —
  // this fixes that ambiguity at the source rather than hoping detection
  // guesses right.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// ENUMS
// --------------------------------------------------------------------------

enum SystemRole {
  SUPER_ADMIN   // Anthropic-style platform owner, manages all tenants
  COMPANY_ADMIN // Owns/manages a single tenant (company)
  TEAM_LEAD     // Optional intermediate role, manages a team
  WORKER        // Regular chat user
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum ConversationType {
  DIRECT
  GROUP
  TEAM
  // Sprint 3: Smart Channels — each tied to its own operational context
  SHIFT         // scoped to a ShiftLog (open/close-shift crew coordination)
  STATION       // scoped to a Station (all staff at that location)
  TASK          // scoped to a Task (discussion around one specific task/inspection)
  ANNOUNCEMENT  // company-wide, posting restricted to admins/managers (see postingRestricted)
  EMERGENCY     // company or station-wide, posting restricted, always high-priority delivery
}

enum MessageType {
  TEXT
  VOICE
  SYSTEM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  EXPORT
}

// --------------------------------------------------------------------------
// TENANT / COMPANY
// --------------------------------------------------------------------------

model Company {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique // used in subdomain / tenant routing
  logoUrl         String?
  industry        String?
  defaultLanguage String   @default("en")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations (all tenant-scoped data hangs off Company for isolation)
  users             User[]
  teams             Team[]
  conversations     Conversation[]
  subscription      Subscription?
  supportedLanguages CompanyLanguage[]
  auditLogs         AuditLog[]

  // Sprint 2: Task Engine / Approval Engine / domain modules
  taskTemplates TaskTemplate[]
  tasks         Task[]
  approvalFlows ApprovalFlow[]
  approvals     Approval[]
  shifts        Shift[]
  shiftLogs     ShiftLog[]
  stations      Station[]
  inspections   Inspection[]
  fuelRequests  FuelRequest[]

  // Sprint 3
  departments      Department[]
  chatPolicyRules  ChatPolicyRule[]
  dictionaryTerms  CompanyDictionaryTerm[]

  @@index([slug])
  @@map("companies")
}

// --------------------------------------------------------------------------
// USERS / ROLES / PERMISSIONS
// --------------------------------------------------------------------------

model User {
  id                String     @id @default(uuid())
  companyId         String?    // null only for SUPER_ADMIN (platform-level user)
  company           Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email             String
  phone             String?
  passwordHash      String
  firstName         String
  lastName          String
  avatarUrl         String?

  systemRole        SystemRole @default(WORKER)
  isActive          Boolean    @default(true)
  emailVerifiedAt   DateTime?

  // Sprint 3: Enterprise onboarding + Visibility Engine
  status            UserStatus      @default(ACTIVE)
  credentialType    CredentialType?
  departmentId      String?
  department        Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  primaryStationId  String?
  primaryStation    Station?        @relation(fields: [primaryStationId], references: [id], onDelete: SetNull)
  // Per-user override of how far up the hierarchy this user can see others
  // in the Company Directory. Null falls back to the role-based default
  // resolved by DirectoryService (see docs/visibility-engine.md).
  directoryVisibilityScope VisibilityScope?

  preferredLanguage String     @default("en")

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastLoginAt       DateTime?

  // Relations
  roles             UserRole[]
  teamMemberships   TeamMember[]
  refreshTokens     RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  otpTokens         OtpToken[]
  sentMessages      Message[]            @relation("MessageSender")
  conversations     ConversationMember[]
  preferences       UserPreference?
  auditLogs         AuditLog[]
  notifications     Notification[]

  // Multi-tenant data isolation: composite uniqueness scoped by company
  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  companyId   String?  // null = global/system role template, otherwise custom per-company role
  name        String
  description String?
  isSystem    Boolean  @default(false) // true for built-in roles that can't be deleted
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]
  approvalSteps ApprovalStep[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "users.create", "teams.manage", "conversations.moderate"
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// --------------------------------------------------------------------------
// TEAMS
// --------------------------------------------------------------------------

model Team {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       TeamMember[]
  conversations Conversation[]

  // Sprint 2
  tasks  Task[]
  shifts Shift[]

  @@index([companyId])
  @@map("teams")
}

model TeamMember {
  teamId   String
  userId   String
  isLead   Boolean  @default(false)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

// --------------------------------------------------------------------------
// LANGUAGES
// --------------------------------------------------------------------------

model Language {
  code      String  @id // ISO 639-1, e.g. "en", "ar", "hi", "tl"
  name      String
  nativeName String
  isRtl     Boolean @default(false)
  isActive  Boolean @default(true)

  companies CompanyLanguage[]

  @@map("languages")
}

model CompanyLanguage {
  companyId String
  langCode  String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  language  Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  @@id([companyId, langCode])
  @@map("company_languages")
}

model UserPreference {
  userId               String  @id
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationsEnabled Boolean @default(true)
  voiceAutoTranscribe  Boolean @default(true)
  theme                String  @default("system")
  updatedAt            DateTime @updatedAt

  @@map("user_preferences")
}

// --------------------------------------------------------------------------
// CONVERSATIONS / MESSAGES
// --------------------------------------------------------------------------

model Conversation {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      ConversationType  @default(DIRECT)
  teamId    String?
  team      Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  title     String?

  // Sprint 3: Smart Channels — optional context anchors. At most one of
  // these is set, matching `type` (e.g. type=SHIFT implies contextShiftLogId
  // is set and the others are null) — enforced in ConversationsService, not
  // at the DB level, to keep the schema simple (a DB-level CHECK constraint
  // per type would need raw SQL Prisma doesn't model declaratively).
  contextShiftLogId String?
  contextStationId  String?
  contextTaskId     String?
  contextStation    Station? @relation(fields: [contextStationId], references: [id], onDelete: SetNull)

  // True for ANNOUNCEMENT/EMERGENCY channels: only COMPANY_ADMIN/SUPER_ADMIN
  // (and, for EMERGENCY, anyone holding a company-configured "Manager"-tier
  // custom Role) may post; everyone else has read-only access — enforced in
  // MessagesService.sendText, not here.
  postingRestricted Boolean  @default(false)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([companyId])
  @@map("conversations")
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("MessageSender", fields: [senderId], references: [id])

  type           MessageType   @default(TEXT)
  status         MessageStatus @default(SENT)

  // Original content as authored by sender
  originalText   String?
  originalLang   String?

  // Voice message support (Phase 1 storage only, processing in Phase 2)
  audioUrl       String?
  audioDurationMs Int?

  createdAt      DateTime      @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  translations   MessageTranslation[]
  receipts       MessageReceipt[]
  attachments    MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// Phase-2-ready: stores per-language translated payloads once
// the Translation service (see voice-processing module) is implemented.
model MessageTranslation {
  id            String   @id @default(uuid())
  messageId     String
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  langCode      String
  translatedText String
  engine        String?  // which provider produced it (for Phase 2)
  version       Int      @default(1) // incremented on re-translation (provider/dictionary change)
  createdAt     DateTime @default(now())

  @@unique([messageId, langCode])
  @@map("message_translations")
}

// Per-recipient delivery/read tracking (needed for group conversations)
model MessageReceipt {
  messageId   String
  userId      String
  status      MessageStatus @default(SENT)
  updatedAt   DateTime      @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_receipts")
}

// --------------------------------------------------------------------------
// AUTH
// --------------------------------------------------------------------------

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@map("refresh_tokens")
}

// --------------------------------------------------------------------------
// SUBSCRIPTIONS (Super Admin managed)
// --------------------------------------------------------------------------

model Subscription {
  id           String             @id @default(uuid())
  companyId    String             @unique
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @default(TRIAL)
  status       SubscriptionStatus @default(ACTIVE)
  seatsLimit   Int                @default(10)
  startedAt    DateTime           @default(now())
  renewsAt     DateTime?
  canceledAt   DateTime?

  @@map("subscriptions")
}

// --------------------------------------------------------------------------
// AUDIT LOG
// --------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String      // e.g. "User", "Message", "Company"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([companyId])
  @@index([actorId])
  @@map("audit_logs")
}

// ==========================================================================
// SPRINT 2 ADDITIONS
// Vertical Slice 1: Messaging Core completion (Attachments)
// Vertical Slice 2: Task Management Architecture (generic engines +
//                    fuel-station domain modules as first consumer)
//
// DESIGN PRINCIPLE: WorkflowEngine / ApprovalEngine / DynamicForms /
// TaskEngine are sector-agnostic. Domain entities (Station, Tank,
// FuelRequest, Inspection) are thin modules that reference the engine
// (ApprovalFlow, TaskTemplate) rather than hardcoding their own logic —
// so the same engine will serve factories, hospitals, construction
// sites, or security operations later by simply defining new
// TaskTemplates / ApprovalFlows, with zero engine-level changes.
// ==========================================================================

// --------------------------------------------------------------------------
// ENUMS — Messaging attachments
// --------------------------------------------------------------------------

enum AttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  SIGNATURE
}

// --------------------------------------------------------------------------
// ENUMS — Dynamic Forms / Task Engine
// --------------------------------------------------------------------------

// NOTE: TaskFieldType is intentionally NOT declared here. It was
// previously declared as a Prisma enum but never used as an actual
// column type anywhere (TaskTemplate.fields is a Json column storing
// field definitions dynamically) — Prisma silently drops enums that
// aren't referenced by any model field from the generated client,
// which caused a confirmed production build failure. It now lives as
// a plain TypeScript enum in
// src/modules/task-engine/task-field-type.enum.ts, decoupled from
// Prisma entirely, which is also the architecturally correct home for
// an application-level (not database-level) concept.

enum TaskStatus {
  DRAFT        // template instantiated, not yet assigned
  ASSIGNED
  IN_PROGRESS
  SUBMITTED    // worker submitted TaskResponse, awaiting approval if required
  APPROVED
  REJECTED
  RETURNED     // sent back to worker for correction
  COMPLETED
  CANCELED
}

// --------------------------------------------------------------------------
// ENUMS — Approval / Workflow Engine
// --------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELED
  COMPLETED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  RETURN
  COMMENT
}

// --------------------------------------------------------------------------
// ENUMS — Shift Management (domain module)
// --------------------------------------------------------------------------

enum ShiftLogStatus {
  OPEN
  CLOSED
}

// --------------------------------------------------------------------------
// ENUMS — Fuel Station domain module
// --------------------------------------------------------------------------

enum FuelRequestStatus {
  DRAFT
  PENDING_SUPERVISOR
  PENDING_MANAGER
  APPROVED
  REJECTED
  COMPLETED
}

// ==========================================================================
// MESSAGING CORE — Attachments
// ==========================================================================

// Generic file attachment on a chat Message (images/documents; voice
// messages continue to use Message.audioUrl directly for the primary
// clip, this model covers *additional* files such as photos shared in
// conversation, PDFs, etc.)
model MessageAttachment {
  id        String         @id @default(uuid())
  messageId String
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind      AttachmentKind
  url       String
  fileName  String?
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime       @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

// ==========================================================================
// DYNAMIC FORMS + TASK ENGINE (generic, sector-agnostic)
// ==========================================================================

// A reusable form definition a Company Admin designs once and instantiates
// many times as Tasks. `fields` holds an ordered JSON array of field
// definitions, e.g.:
// [{ "id": "f1", "type": "NUMBER", "label": "Meter reading", "required": true },
//  { "id": "f2", "type": "PHOTO",  "label": "Photo of meter", "required": true }]
// This keeps the schema stable while letting every company build entirely
// different forms without migrations.
model TaskTemplate {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  domainTag      String?  // free-form categorization, e.g. "fuel_station", "safety_inspection"
  fields         Json     // TaskFieldDefinition[] — validated at the application layer
  approvalFlowId String?  // optional: submissions of this template route through this flow
  approvalFlow   ApprovalFlow? @relation(fields: [approvalFlowId], references: [id], onDelete: SetNull)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks Task[]

  @@index([companyId])
  @@map("task_templates")
}

// A concrete unit of work. May be instantiated from a TaskTemplate
// (structured/dynamic form) or created ad-hoc (templateId null, simple
// title/description checklist item).
model Task {
  id          String     @id @default(uuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId  String?
  template    TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      TaskStatus @default(DRAFT)
  dueAt       DateTime?
  createdById String
  teamId      String?    // optional: task scoped to a team (e.g. a station's crew)
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignments TaskAssignment[]
  responses   TaskResponse[]
  // Domain modules point back at a Task rather than duplicating workflow state.
  inspection    Inspection?
  fuelRequest   FuelRequest?
  shiftLogOpen  ShiftLog[] @relation("ShiftOpenTask")
  shiftLogClose ShiftLog[] @relation("ShiftCloseTask")

  @@index([companyId])
  @@index([templateId])
  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  assignedAt DateTime @default(now())
  dueAt      DateTime?

  @@unique([taskId, userId])
  @@map("task_assignments")
}

// A worker's completed submission for a Task. `answers` maps each
// TaskTemplate field id to the submitted value (primitive types only;
// media fields store a reference to a TaskAttachment id instead of raw
// data). One Task can have multiple responses if RETURNED and resubmitted.
model TaskResponse {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedById String
  answers      Json     // { [fieldId]: string | number | boolean | { attachmentId: string } }
  submittedAt  DateTime @default(now())

  attachments TaskAttachment[]
  approval    Approval?

  @@index([taskId])
  @@map("task_responses")
}

// Media/file captured for a specific dynamic field within a TaskResponse
// (PHOTO/VIDEO/AUDIO/SIGNATURE/GPS field types).
model TaskAttachment {
  id             String         @id @default(uuid())
  taskResponseId String
  taskResponse   TaskResponse   @relation(fields: [taskResponseId], references: [id], onDelete: Cascade)
  fieldId        String         // matches an id inside TaskTemplate.fields
  kind           AttachmentKind
  url            String
  gpsLat         Float?
  gpsLng         Float?
  capturedAt     DateTime       @default(now())

  @@index([taskResponseId])
  @@map("task_attachments")
}

// ==========================================================================
// APPROVAL / WORKFLOW ENGINE (generic, sector-agnostic)
// ==========================================================================

// A reusable chain of approval steps, e.g. Worker -> Supervisor -> Manager.
// `entityType` documents which domain objects use this flow (informational;
// the actual link is via Approval.entityType/entityId) so one company can
// define distinct flows per use case (e.g. "FuelRequest" vs "TaskResponse").
model ApprovalFlow {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  entityType String   // e.g. "FuelRequest", "TaskResponse" — free-form tag
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  steps         ApprovalStep[]
  approvals     Approval[]
  taskTemplates TaskTemplate[]

  @@index([companyId])
  @@map("approval_flows")
}

// One step in a flow. `approverRoleId` points at the (per-company custom)
// Role that must act at this step — this is what makes Worker -> Supervisor
// -> Manager configurable per company rather than hardcoded to SystemRole.
model ApprovalStep {
  id             String       @id @default(uuid())
  flowId         String
  flow           ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  stepOrder      Int
  name           String       // e.g. "Supervisor Review"
  approverRoleId String
  approverRole   Role         @relation(fields: [approverRoleId], references: [id])

  @@unique([flowId, stepOrder])
  @@map("approval_steps")
}

// One instance of an entity going through an ApprovalFlow. `entityType` +
// `entityId` form a polymorphic reference (e.g. entityType="FuelRequest",
// entityId=<FuelRequest.id>) so the engine stays decoupled from domain
// tables — no foreign key coupling required in either direction beyond
// the optional 1:1 relations declared on the domain side for convenience.
model Approval {
  id             String         @id @default(uuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flowId         String
  flow           ApprovalFlow   @relation(fields: [flowId], references: [id])
  entityType     String
  entityId       String
  currentStep    Int            @default(1)
  status         ApprovalStatus @default(PENDING)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  actions      ApprovalAction[]
  taskResponse TaskResponse?    @relation(fields: [taskResponseId], references: [id])
  taskResponseId String?        @unique
  fuelRequest  FuelRequest?

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("approvals")
}

// Full audit trail of every decision made on an Approval: who, what step,
// what action (APPROVE/REJECT/RETURN/COMMENT), and any comment text.
// This IS the audit trail required by the workflow spec — kept separate
// from the generic AuditLog (which covers CRUD/security events) because
// approval history has richer, workflow-specific semantics (step number,
// action type) that are queried together far more often than joined with
// unrelated audit events.
model ApprovalAction {
  id         String             @id @default(uuid())
  approvalId String
  approval   Approval           @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  stepOrder  Int
  actorId    String
  action     ApprovalActionType
  comment    String?
  createdAt  DateTime           @default(now())

  @@index([approvalId])
  @@map("approval_actions")
}

// ==========================================================================
// SHIFT MANAGEMENT (domain module, built on the Task Engine)
// ==========================================================================

model Shift {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Morning", "Night"
  startTime String   // "06:00" — recurring daily pattern; concrete occurrences are ShiftLogs
  endTime   String   // "14:00"
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  logs ShiftLog[]

  @@index([companyId])
  @@map("shifts")
}

// A concrete occurrence of a worker opening/closing a shift. The open and
// close checklists are just Tasks instantiated from a TaskTemplate (e.g.
// "Open Shift Checklist" with meter-reading/photo/signature fields) — the
// ShiftLog just anchors the two Task instances together with real
// timestamps and status, so shift logic reuses the Task Engine rather than
// re-implementing dynamic-form handling.
model ShiftLog {
  id       String         @id @default(uuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shiftId  String
  shift    Shift          @relation(fields: [shiftId], references: [id])
  userId   String
  stationId String?
  station  Station?       @relation(fields: [stationId], references: [id], onDelete: SetNull)

  openTaskId  String?
  openTask    Task?        @relation("ShiftOpenTask", fields: [openTaskId], references: [id])
  closeTaskId String?
  closeTask   Task?        @relation("ShiftCloseTask", fields: [closeTaskId], references: [id])

  status    ShiftLogStatus @default(OPEN)
  startedAt DateTime       @default(now())
  endedAt   DateTime?

  @@index([companyId])
  @@index([stationId])
  @@map("shift_logs")
}

// ==========================================================================
// FUEL STATION DOMAIN MODULE (first concrete consumer of the generic
// engines above — a template for how future sector modules should be built)
// ==========================================================================

model Station {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tanks       Tank[]
  shiftLogs   ShiftLog[]
  inspections Inspection[]
  fuelRequests FuelRequest[]
  conversations Conversation[]
  primaryUsers  User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("stations")
}

model Tank {
  id           String   @id @default(uuid())
  stationId    String
  station      Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  code         String
  fuelType     String   // e.g. "Diesel", "Petrol95"
  capacityLiters Float
  lastKnownLevel Float?
  updatedAt    DateTime @updatedAt

  fuelRequests FuelRequest[]

  @@unique([stationId, code])
  @@index([stationId])
  @@map("tanks")
}

// A routine inspection is simply a Task (from an "Inspection" TaskTemplate)
// anchored to a Station for domain-specific querying (e.g. "show all
// inspections for Station X this month").
model Inspection {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stationId String
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  taskId    String   @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([stationId])
  @@map("inspections")
}

// Worker-initiated fuel replenishment request. Routes through an
// ApprovalFlow (Worker -> Supervisor -> Manager) via the generic engine;
// `status` mirrors the Approval's progress for fast domain-level queries
// without joining into the Approval engine on every list view.
model FuelRequest {
  id                String            @id @default(uuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stationId         String
  station           Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  tankId            String
  tank              Tank              @relation(fields: [tankId], references: [id], onDelete: Cascade)
  requestedById     String
  currentLevel      Float
  requestedQuantity Float
  photoUrl          String?
  notes             String?
  status            FuelRequestStatus @default(DRAFT)

  taskId     String?   @unique
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approvalId String?   @unique
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([stationId])
  @@map("fuel_requests")
}

// --------------------------------------------------------------------------
// PASSWORD RESET (Forgot Password flow)
// --------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==========================================================================
// SPRINT 3 ADDITIONS — Product Review closure items
// Enterprise Onboarding (OTP activation) + Company Directory +
// Visibility Engine + Chat Policies + Smart Channels + Company Dictionary
// + Translation versioning
// ==========================================================================

// --------------------------------------------------------------------------
// ENUMS — Onboarding / Identity
// --------------------------------------------------------------------------

enum UserStatus {
  INVITED   // account created by Company Admin/HR, worker has not activated yet
  ACTIVE    // OTP verified + credential (password or PIN) set
  DISABLED
}

enum OtpChannel {
  PHONE
  EMAIL
}

enum OtpPurpose {
  ACTIVATION
}

enum CredentialType {
  PASSWORD
  PIN
}

// --------------------------------------------------------------------------
// ENUMS — Visibility Engine
// --------------------------------------------------------------------------

// Ordered from narrowest to broadest — a user with scope X can see every
// user within that same tier of the hierarchy (see docs/visibility-engine.md
// for the exact resolution algorithm implemented in DirectoryService).
enum VisibilityScope {
  WORKER      // sees only themself (rare; e.g. a newly invited user pre-activation)
  TEAM
  DEPARTMENT
  STATION
  COMPANY
}

// --------------------------------------------------------------------------
// ONBOARDING — OTP-based activation (Enterprise scenario: HR/Company Admin
// creates the account, worker only ACTIVATES it — never self-registers)
// --------------------------------------------------------------------------

model OtpToken {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     OtpChannel
  purpose     OtpPurpose @default(ACTIVATION)
  destination String     // the phone number or email the code was sent to (audit trail)
  codeHash    String     // never store the raw OTP
  attempts    Int        @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@map("otp_tokens")
}

// --------------------------------------------------------------------------
// COMPANY DIRECTORY — Departments (new grouping tier between Team and Station/Company)
// --------------------------------------------------------------------------

model Department {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[] @relation("DepartmentHierarchy")
  createdAt          DateTime     @default(now())

  users    User[]
  teams    Team[]
  stations Station[]

  @@index([companyId])
  @@map("departments")
}

// --------------------------------------------------------------------------
// CHAT POLICIES — who is allowed to start a conversation with whom
// --------------------------------------------------------------------------

// Rules are evaluated by (fromRole, toRole) pair. A missing rule for a pair
// defaults to DENY (safe-by-default) — see ChatPolicyService for the exact
// evaluation order and built-in defaults seeded per company.
model ChatPolicyRule {
  id        String     @id @default(uuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromRole  SystemRole
  toRole    SystemRole
  allowed   Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@unique([companyId, fromRole, toRole])
  @@index([companyId])
  @@map("chat_policy_rules")
}

// --------------------------------------------------------------------------
// COMPANY DICTIONARY — per-company terminology consulted BEFORE any
// general-purpose translation provider call (see TranslationPolicyService)
// --------------------------------------------------------------------------

model CompanyDictionaryTerm {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceTerm      String
  sourceLanguage  String
  targetLanguage  String
  translatedTerm  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, sourceTerm, sourceLanguage, targetLanguage])
  @@index([companyId])
  @@map("company_dictionary_terms")
}

// ==========================================================================
// TRANSLATION ENGINE (standalone, reusable module — see
// src/modules/translation-engine/. Deliberately has ZERO foreign keys to
// any WorkForce Connect entity like Message/Conversation — everything is
// keyed by companyId + text/language only, so this schema section (and
// its service code) could be lifted into any other product unchanged.)
// ==========================================================================

enum TranslationProviderType {
  OPENAI
  GOOGLE
  AZURE
  DEEPL
  OFFLINE_STUB
}

enum TranslationResolutionSource {
  SAME_LANGUAGE
  CACHE
  DICTIONARY
  MEMORY
  PROVIDER
}

// Per-company (or platform-default, companyId=null) provider selection —
// switchable from the admin panel with zero code changes. `apiKeyEnvVar`
// stores the NAME of an environment variable holding the real secret
// (never the secret itself) — keeps credentials out of the database
// entirely, consistent with how the rest of this codebase handles secrets.
model TranslationProviderConfig {
  id            String                  @id @default(uuid())
  companyId     String?
  providerType  TranslationProviderType
  apiKeyEnvVar  String?                 // e.g. "OPENAI_API_KEY" — null for OFFLINE_STUB
  region        String?                 // e.g. Azure region, unused by other providers
  model         String?                 // e.g. an OpenAI model name, unused by other providers
  isActive      Boolean                 @default(true)
  priority      Int                     @default(0) // lower = tried first when multiple are active (fallback chain)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([companyId, providerType])
  @@index([companyId])
  @@map("translation_provider_configs")
}

// Fast-path exact-match cache — the FIRST thing consulted (after the
// same-language short-circuit) by the Smart Translation Policy. Rows are
// safe to invalidate/expire at any time (purely a speed optimization,
// never the source of truth for a "correct" translation).
model TranslationCacheEntry {
  id              String   @id @default(uuid())
  companyId       String
  sourceTextHash  String   // sha256 of the normalized source text — keeps the index compact regardless of text length
  sourceText      String   // kept alongside the hash for human-readable audit/debugging
  sourceLanguage  String
  targetLanguage  String
  translatedText  String
  providerType    TranslationProviderType?
  tokensUsed      Int?
  costEstimate    Decimal? @db.Decimal(10, 6)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, sourceTextHash, sourceLanguage, targetLanguage])
  @@index([companyId])
  @@map("translation_cache_entries")
}

// Translation Memory — distinct from the cache: represents translation
// pairs worth REUSING long-term (accumulates a usage counter), consulted
// AFTER the Company Dictionary and BEFORE calling an AI provider. Unlike
// the cache, entries here are never silently evicted/expired.
model TranslationMemoryEntry {
  id              String   @id @default(uuid())
  companyId       String
  sourceTextHash  String
  sourceText      String
  sourceLanguage  String
  targetLanguage  String
  translatedText  String
  timesReused     Int      @default(0)
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([companyId, sourceTextHash, sourceLanguage, targetLanguage])
  @@index([companyId])
  @@map("translation_memory_entries")
}

// Full audit trail of every translation request — which resolution path
// answered it (cache/dictionary/memory/provider), token/cost accounting,
// and who triggered it. This is the source for usage-based billing
// (see Subscription & Billing Engine) as well as compliance/debugging.
model TranslationAuditLog {
  id                String                       @id @default(uuid())
  companyId         String
  requestedById     String?
  sourceLanguage    String
  targetLanguage    String
  resolutionSource  TranslationResolutionSource
  providerType      TranslationProviderType?
  tokensUsed        Int?
  costEstimate      Decimal?                     @db.Decimal(10, 6)
  createdAt         DateTime                     @default(now())

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("translation_audit_logs")
}

// ==========================================================================
// SUBSCRIPTION & BILLING ENGINE (standalone, reusable module — see
// src/modules/billing-engine/. Not tied to any specific payment gateway
// — PaymentTransaction.gatewayType is an open enum/string and actual
// gateway integration is a Provider Pattern, same philosophy as the
// Translation Engine above.)
// ==========================================================================

enum BillingModel {
  PER_USER          // priced by seat count
  MONTHLY_TIER       // flat Starter/Professional/Enterprise style tiers
  PAY_AS_YOU_GO      // metered, billed per unit consumed
  AI_TOKEN_PACKAGE   // prepaid token bundles
  HYBRID             // combination of the above within one plan
}

enum FeatureUnit {
  COUNT       // e.g. users, API calls, OCR pages
  TOKENS      // AI tokens
  GB          // storage
  MINUTES     // voice minutes
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Platform-level catalog — Super Admin manages these, companies subscribe
// to one. Deliberately NOT tied to Company (many companies share a plan).
model BillingPlan {
  id           String        @id @default(uuid())
  code         String        @unique // e.g. "starter", "professional", "enterprise", "payg"
  name         String
  description  String?
  billingModel BillingModel
  basePrice    Decimal       @db.Decimal(10, 2)
  currency     String        @default("SAR")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  featureLimits   PlanFeatureLimit[]
  subscriptions   CompanySubscription[]
  promotions      Promotion[]

  @@map("billing_plans")
}

// Catalog of meterable features — platform-level, referenced by code
// (e.g. "max_users", "ai_tokens_monthly", "storage_gb",
// "voice_minutes_monthly", "ocr_pages_monthly", "api_calls_monthly")
// from PlanFeatureLimit, UsageCounter, and AddOn. New features are added
// here without any schema migration to Plan/UsageCounter.
model BillingFeature {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  unit        FeatureUnit
  description String?

  planLimits     PlanFeatureLimit[]
  usageCounters  UsageCounter[]
  addOns         AddOn[]

  @@map("billing_features")
}

// Per-plan limit for a given feature. `limit = null` means unlimited.
// `overageUnitPrice` enables Pay-As-You-Go / Hybrid billing beyond the
// included limit (null means overage is simply blocked, not billed).
model PlanFeatureLimit {
  id                String         @id @default(uuid())
  planId            String
  plan              BillingPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId         String
  feature           BillingFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  includedLimit     Int?           // null = unlimited
  overageUnitPrice  Decimal?       @db.Decimal(10, 4)

  @@unique([planId, featureId])
  @@map("plan_feature_limits")
}

// A Company's active subscription to a BillingPlan. Named
// "CompanySubscription" (not reusing the existing `Subscription` model
// from Sprint 1) since this is the new Billing Engine's own concept with
// a richer shape — the legacy `Subscription` model is left completely
// untouched to avoid destabilizing the working MVP; wiring the two
// together is a deliberate follow-up step, not done in this delivery.
model CompanySubscription {
  id            String       @id @default(uuid())
  companyId     String       @unique
  planId        String
  plan          BillingPlan  @relation(fields: [planId], references: [id])
  startedAt     DateTime     @default(now())
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelledAt   DateTime?
  isActive      Boolean      @default(true)
  isTrial       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  usageCounters UsageCounter[]
  invoices      Invoice[]
  addOns        CompanyAddOn[]

  @@index([companyId])
  @@map("company_subscriptions")
}

// Tracks consumption of a specific feature within a specific billing
// period — the shared mechanism behind AI Usage Tracking, Storage Usage,
// Voice Minutes, OCR Pages, and API Usage (all are just different
// BillingFeature codes metered through this one generic table).
model UsageCounter {
  id             String               @id @default(uuid())
  companyId      String
  subscriptionId String?
  subscription   CompanySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  featureId      String
  feature        BillingFeature       @relation(fields: [featureId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  usedAmount     Decimal              @default(0) @db.Decimal(14, 4)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([companyId, featureId, periodStart, periodEnd])
  @@index([companyId])
  @@map("usage_counters")
}

// Prepaid AI token balance per company — backs the AI Token Package
// billing model. Every debit/credit is recorded in
// TokenWalletTransaction for a full audit trail (never mutate the
// balance without a corresponding transaction row).
model TokenWallet {
  id             String   @id @default(uuid())
  companyId      String   @unique
  balanceTokens  Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  transactions TokenWalletTransaction[]

  @@map("token_wallets")
}

model TokenWalletTransaction {
  id              String      @id @default(uuid())
  walletId        String
  wallet          TokenWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Decimal     @db.Decimal(14, 2) // positive = credit (top-up), negative = debit (usage)
  reason          String      // free-form: "top_up", "translation_usage", "manual_adjustment", ...
  relatedEntityType String?
  relatedEntityId   String?
  createdAt       DateTime    @default(now())

  @@index([walletId])
  @@map("token_wallet_transactions")
}

model Invoice {
  id             String               @id @default(uuid())
  companyId      String
  subscriptionId String?
  subscription   CompanySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber  String               @unique
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Decimal              @db.Decimal(10, 2)
  discountTotal  Decimal              @default(0) @db.Decimal(10, 2)
  taxTotal       Decimal              @default(0) @db.Decimal(10, 2)
  total          Decimal              @db.Decimal(10, 2)
  currency       String               @default("SAR")
  status         InvoiceStatus        @default(DRAFT)
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime             @default(now())

  lineItems InvoiceLineItem[]
  payments  PaymentTransaction[]
  couponRedemptions CouponRedemption[]

  @@index([companyId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  featureCode String?  // links back to BillingFeature.code when this line is usage-based, null for flat plan fees
  quantity    Decimal  @db.Decimal(14, 4)
  unitPrice   Decimal  @db.Decimal(10, 4)
  amount      Decimal  @db.Decimal(10, 2)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// Abstract payment record — deliberately NOT coupled to a specific
// gateway's SDK/webhook shape. `gatewayType` is a free-form string
// (e.g. "stripe", "paytabs", "manual") rather than a hard-coded enum,
// so adding a new payment gateway later needs zero schema changes —
// exactly the same Provider Pattern principle used for translation
// providers.
model PaymentTransaction {
  id              String        @id @default(uuid())
  companyId       String
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  gatewayType     String
  gatewayReference String?
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("SAR")
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId])
  @@index([invoiceId])
  @@map("payment_transactions")
}

model Coupon {
  id               String       @id @default(uuid())
  code             String       @unique
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2) // percentage (0-100) or fixed amount depending on discountType
  maxRedemptions   Int?         // null = unlimited
  redeemedCount    Int          @default(0)
  validFrom        DateTime?
  validUntil       DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())

  redemptions CouponRedemption[]
  promotions  Promotion[]

  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  companyId  String
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  redeemedAt DateTime @default(now())

  @@index([couponId])
  @@index([companyId])
  @@map("coupon_redemptions")
}

model Promotion {
  id            String      @id @default(uuid())
  name          String
  description   String?
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  applicablePlanId String?
  applicablePlan   BillingPlan? @relation(fields: [applicablePlanId], references: [id], onDelete: SetNull)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@map("promotions")
}

// Purchasable extras beyond a plan's included limits (e.g. "+10GB
// storage", "+500 AI tokens/month") — priced independently of the base
// plan and stacked on top of it via CompanyAddOn.
model AddOn {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  description       String?
  price             Decimal         @db.Decimal(10, 2)
  featureId         String?
  feature           BillingFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  extraLimitAmount  Decimal?        @db.Decimal(14, 4) // how much this add-on increases the feature's limit by
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  companyAddOns CompanyAddOn[]

  @@map("add_ons")
}

model CompanyAddOn {
  id             String               @id @default(uuid())
  companyId      String
  subscriptionId String?
  subscription   CompanySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  addOnId        String
  addOn          AddOn                @relation(fields: [addOnId], references: [id])
  activatedAt    DateTime             @default(now())
  expiresAt      DateTime?
  isActive       Boolean              @default(true)

  @@index([companyId])
  @@map("company_add_ons")
}

// Per-company payment gateway selection — same Provider/Strategy Pattern
// as TranslationProviderConfig. `apiKeyEnvVar`/`secretKeyEnvVar` store
// environment variable NAMES only, never raw credentials.
model PaymentGatewayConfig {
  id               String   @id @default(uuid())
  companyId        String?
  gatewayType      String   // "STRIPE", "HYPERPAY", "PAYTABS", "MYFATOORAH", "MOYASAR", "STC_PAY", ...
  apiKeyEnvVar     String?
  secretKeyEnvVar  String?
  merchantId       String?
  isActive         Boolean  @default(true)
  priority         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, gatewayType])
  @@index([companyId])
  @@map("payment_gateway_configs")
}

// ---- Webhooks --------------------------------------------------------------

enum WebhookEventType {
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRED
  INVOICE_PAID
  INVOICE_OVERDUE
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  companyId String
  url       String
  secret    String   // HMAC signing secret for payload verification by the receiver
  events    WebhookEventType[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String           @id @default(uuid())
  endpointId  String
  endpoint    WebhookEndpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventType   WebhookEventType
  payload     Json
  statusCode  Int?
  succeeded   Boolean          @default(false)
  attempts    Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([endpointId])
  @@map("webhook_deliveries")
}

// ==========================================================================
// NOTIFICATION CENTER
// ==========================================================================

enum NotificationType {
  TASK_ASSIGNED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  FUEL_REQUEST_UPDATED
  BROADCAST_RECEIVED
  SUBSCRIPTION_EXPIRING
  SYSTEM
}

model Notification {
  id         String            @id @default(uuid())
  companyId  String?
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  link       String?           // frontend route to navigate to on click, e.g. "/tasks/123"
  isRead     Boolean           @default(false)
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}
