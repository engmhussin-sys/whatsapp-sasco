# Copy this file to `.env.local` for local development — Next.js loads
# .env.local automatically and it's already gitignored, so real values
# never get committed. (.env.example documents the same variables for
# production/Railway build-time configuration.)

# Base URL of the backend REST API (must include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Base URL of the backend WebSocket server (no path suffix)
NEXT_PUBLIC_WS_URL=http://localhost:3000
